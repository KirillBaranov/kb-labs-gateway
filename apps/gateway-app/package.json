{
  "name": "@kb-labs/gateway-app",
  "version": "0.5.0",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "vitest run src/__tests__/*.e2e.test.ts",
    "test:live": "vitest run src/__tests__/live-gateway.e2e.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/http-proxy": "^11.4.1",
    "@fastify/swagger": ">=9.5.1",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.0.1",
    "fastify-type-provider-zod": "^6.0.0",
    "ws": "^8.18.3",
    "@kb-labs/shared-http": "link:../../../../platform/kb-labs-shared/packages/shared-http",
    "@kb-labs/core-config": "link:../../../../platform/kb-labs-core/packages/core-config",
    "@kb-labs/core-contracts": "link:../../../../platform/kb-labs-core/packages/core-contracts",
    "@kb-labs/core-platform": "link:../../../../platform/kb-labs-core/packages/core-platform",
    "@kb-labs/core-registry": "link:../../../../platform/kb-labs-core/packages/core-registry",
    "@kb-labs/core-runtime": "link:../../../../platform/kb-labs-core/packages/core-runtime",
    "@kb-labs/core-sys": "link:../../../../platform/kb-labs-core/packages/core-sys",
    "@kb-labs/plugin-contracts": "link:../../../kb-labs-plugin/packages/plugin-contracts",
    "@kb-labs/gateway-auth": "workspace:*",
    "@kb-labs/gateway-contracts": "workspace:*",
    "@kb-labs/gateway-core": "workspace:*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@kb-labs/devkit": "link:../../../kb-labs-devkit",
    "@types/ws": "^8.5.14",
    "eslint": "^9",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "@kb-labs/shared-testing-e2e": "workspace:*"
  },
  "kb": {
    "manifest": "./dist/manifest.js"
  }
